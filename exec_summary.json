 "candidates": [
  {
   "key": "itpm_broken_cache",
   "verdict": "SURVIVES",
   "ruled_out": false,
   "requests_headroom": 1.0,
   "tokens_headroom": 8.532273660393106e-05,
   "reuse_rate": 0.0,
   "title": "The provider isn't remembering our conversations",
   "short": "Re-sent history counts against the token budget",
   "body": "Each agent re-sends its whole conversation every step. The provider can remember that history for us, and what it remembers is free against our budget. If that isn't switched on, or is silently broken, every step pays for the whole conversation again.",
   "group": "token budget"
  },
  {
   "key": "cache_herd",
   "verdict": "SURVIVES",
   "ruled_out": false,
   "requests_headroom": 1.0,
   "tokens_headroom": 1.4992080593453328e-05,
   "reuse_rate": 0.938875905575905,
   "title": "Agents arriving together, all paying full price",
   "short": "Simultaneous starts each pay for the same shared text",
   "body": "The provider can only reuse remembered text once the first answer has started coming back. When hundreds of agents start at the same instant, none of them can reuse anything the others are still writing, so they all pay full price for the same shared instructions at once.",
   "group": "token budget"
  },
  {
   "key": "rpm_burst",
   "verdict": "SURVIVES",
   "ruled_out": false,
   "requests_headroom": 6.829682184994506e-05,
   "tokens_headroom": 1.0,
   "reuse_rate": 0.9369975756435354,
   "title": "Too many calls in the same second",
   "short": "The per-minute average hides sub-second bursts",
   "body": "The call limit is enforced continuously, not once a minute. A limit of 60 calls a minute behaves like one call per second. Our dashboard averages over a minute, so a burst that trips the limit is invisible to it.",
   "group": "call rate"
  },
  {
   "key": "acceleration",
   "verdict": "SURVIVES",
   "ruled_out": false,
   "requests_headroom": 1.0,
   "tokens_headroom": 1.0,
   "reuse_rate": 0.9224570768225806,
   "title": "Ramping up too suddenly",
   "short": "Sharp increases are throttled even when totals look fine",
   "body": "The provider limits how fast our usage can climb, separately from how much we use. A sudden jump at the start of a busy period can be refused even though every total is well within budget.",
   "group": "ramp rate"
  },
  {
   "key": "pool_exhaustion",
   "verdict": "RULED OUT",
   "ruled_out": true,
   "requests_headroom": 1.0,
   "tokens_headroom": 1.0,
   "reuse_rate": 0.922386595201274,
   "title": "The bottleneck is inside our own service",
   "short": "Ruled out: this would slow every call, not just the worst ones",
   "body": "Our own connection limit could queue calls before they ever reach the provider. We ruled this out: it would slow down typical calls as much as the worst ones, and what we see is a normal typical call with a small number of very slow ones.",
   "group": "our own service"
  }
